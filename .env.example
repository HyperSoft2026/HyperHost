# ==============================================================================
# 1. HYPERHOST CONTROL PLANE ENVIRONMENT (Clever Cloud / Web App)
# ==============================================================================
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://CURRENT_HYPERHOST_DOMAIN
PUBLIC_URL=https://CURRENT_HYPERHOST_DOMAIN
CORS_ORIGIN=https://CURRENT_HYPERHOST_DOMAIN

DATABASE_URL=

SESSION_SECRET=
ENCRYPTION_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://CURRENT_HYPERHOST_DOMAIN/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_NOTIFICATION_CHANNEL_ID=
DISCORD_LOGIN_WEBHOOK_URL=
ADMIN_DISCORD_IDS=

# ==============================================================================
# 2. AUTOMATIC PER-HOST RUNTIME PROVISIONER (External Infrastructure Provider)
# ==============================================================================
# Required to automatically provision a dedicated Runtime Server & Node per Host.
# Node credentials (NODE_ID, NODE_TOKEN) are generated automatically per Host
# by the Control Plane and injected during server bootstrap — never added manually.
RUNTIME_PROVIDER=
RUNTIME_PROVIDER_API_TOKEN=
RUNTIME_PROVIDER_API_ENDPOINT=
RUNTIME_PROVIDER_REGION=eu-central
RUNTIME_PROVIDER_IMAGE=ubuntu-24.04-hyperhost-runtime

# Optional fallback enrollment secret for standalone Node Agent testing
RUNTIME_NODE_SECRET=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
