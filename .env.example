# ==============================================================================
# 1. HYPERHOST CONTROL PLANE ENVIRONMENT (Clever Cloud)
# ==============================================================================
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://CURRENT_HYPERHOST_DOMAIN
PUBLIC_URL=https://CURRENT_HYPERHOST_DOMAIN
CORS_ORIGIN=https://CURRENT_HYPERHOST_DOMAIN

DATABASE_URL=

SESSION_SECRET=
ENCRYPTION_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://CURRENT_HYPERHOST_DOMAIN/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_NOTIFICATION_CHANNEL_ID=
DISCORD_LOGIN_WEBHOOK_URL=
ADMIN_DISCORD_IDS=

# ==============================================================================
# 2. CLEVER CLOUD AUTOMATIC PER-HOST RUNTIME PROVISIONER
# ==============================================================================
# Used server-side by CleverCloudRuntimeProvisioner (https://api.clever-cloud.com/)
# to automatically create a dedicated Clever Cloud Node.js Application per Host,
# inject generated NODE_ID / NODE_TOKEN / CONTROL_PLANE_WS_URL / HOST_ID,
# and deploy the standalone Runtime Node Agent.
CLEVER_CLOUD_API_TOKEN=
CLEVER_CLOUD_ORGANISATION_ID=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
