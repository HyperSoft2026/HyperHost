# ==============================================================================
# 1. HYPERHOST CONTROL PLANE ENVIRONMENT (Clever Cloud)
# ==============================================================================
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://CURRENT_HYPERHOST_DOMAIN
PUBLIC_URL=https://CURRENT_HYPERHOST_DOMAIN
CORS_ORIGIN=https://CURRENT_HYPERHOST_DOMAIN

DATABASE_URL=

SESSION_SECRET=
ENCRYPTION_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://CURRENT_HYPERHOST_DOMAIN/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_NOTIFICATION_CHANNEL_ID=
DISCORD_LOGIN_WEBHOOK_URL=
ADMIN_DISCORD_IDS=

# ==============================================================================
# 2. CLEVER CLOUD AUTOMATIC PER-HOST RUNTIME PROVISIONER
# ==============================================================================
# REST API (https://api-bridge.clever-cloud.com/) credentials to create dedicated
# Clever Cloud Applications, configure environment variables, and manage instances:
CLEVER_CLOUD_API_TOKEN=
CLEVER_CLOUD_ORGANISATION_ID=
CLEVER_CLOUD_API_BASE_URL=https://api-bridge.clever-cloud.com
CLEVER_CLOUD_ZONE=par

# Central SSH Private Key for non-interactive Git deployment to Clever Cloud applications
# (git+ssh://git@push.par.clever-cloud.com/app_xxx.git).
# The corresponding public key is registered automatically via PUT /v2/self/keys/hyperhost-central-deployer.
# NEVER commit or expose this key.
CLEVER_CLOUD_SSH_PRIVATE_KEY=
# Optional: if omitted, the public key is automatically derived from the private key
CLEVER_CLOUD_SSH_PUBLIC_KEY=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
