{
  "name": "hyperhost",
  "version": "1.0.0",
  "description": "HyperHost — Professional Discord & Telegram Bot Hosting Platform by HyperSoft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx src/server/index.ts",
    "build": "prisma generate && tsc --noEmit && vite build",
    "prestart": "npm run db:deploy",
    "start": "tsx src/server/index.ts --production",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "prisma": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "vite": "^6.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
